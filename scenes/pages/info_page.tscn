[node name="info_box" parent="." unique_id=1481590261 instance=ExtResource("3_qjxl1")]
layout_mode = 2
icon = ExtResource("4_egyfl")
description = "התעריף המיועד ללקוחות פרטיים ומשקי בית. מחושב על בסיס צריכה מדורגת וכולל את עלות ייצור החשמל, הולכה, וחלוקה לרשת הביתית. תעריף זה מתעדכן מעת לעת על ידי רשות החשמל."

[node name="info_box2" parent="." unique_id=1859338905 instance=ExtResource("3_qjxl1")]
layout_mode = 2
title = "תעריף כללי"
icon = ExtResource("5_egyfl")
description = "חיוב חודשי או דו-חודשי קבוע הנגבה מכל צרכן ללא קשר לכמות החשמל שנצרכה. תשלום זה נועד לכסות את עלויות קריאת המונה, טיפול בצרכן, ותחזוקת חיבור החשמל הבסיסי לנכס."

